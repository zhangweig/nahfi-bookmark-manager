{
  "manifest_version": 3,
  "name": "Nahfi Bookmark Manager",
  "version": "1.1.0",
  "description": "固定快速启动、无框 Liquid Glass 界面、高清图标本地缓存与 Chrome 账号同步。",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nahfi Bookmark Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "32": "icons/icon32.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open Nahfi Bookmark Manager"
    }
  }
}
